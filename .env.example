# NEXUS configuration. Copy to `.env` and adjust. Never commit your real `.env`.

# --- Server -----------------------------------------------------------------
# Keep NEXUS on the loopback interface. Do not expose it to the internet.
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000
# Host headers the server will answer to (protects against DNS rebinding).
NEXUS_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Storage ----------------------------------------------------------------
# Folder for uploaded audio/images/files and the default SQLite database.
NEXUS_DATA_DIR=./data
# Any SQLAlchemy URL. Defaults to sqlite:///<NEXUS_DATA_DIR>/nexus.db
# NEXUS_DATABASE_URL=sqlite:///./data/nexus.db
NEXUS_MAX_UPLOAD_MB=100

# --- AI provider ------------------------------------------------------------
# "ollama" = a language model running on this computer through Ollama (default).
#            If Ollama isn't running, NEXUS falls back to the offline organizer.
# "local"  = offline keyword heuristics only (no model needed).
# Reserved for later: openai, anthropic.
NEXUS_AI_PROVIDER=ollama
NEXUS_OLLAMA_URL=http://127.0.0.1:11434
# gemma3:12b reads text AND images and fits comfortably in 24 GB of memory.
# Faster but less thoughtful: gemma3:4b
NEXUS_OLLAMA_MODEL=gemma3:12b
# Optional separate model for images (empty = use NEXUS_OLLAMA_MODEL).
NEXUS_OLLAMA_VISION_MODEL=
# Seconds to wait for one answer (the first request also loads the model).
NEXUS_OLLAMA_TIMEOUT=300
# How long Ollama keeps the model in memory after the last request.
NEXUS_OLLAMA_KEEP_ALIVE=10m
# Minimum confidence (0-1) for an AI relationship suggestion to be stored.
NEXUS_RELATIONSHIP_THRESHOLD=0.25

# --- Transcription ----------------------------------------------------------
# "whisper_local" = Whisper on this computer (pip install -r requirements-local.txt)
# "placeholder"   = keep recordings, don't transcribe.
NEXUS_TRANSCRIPTION_PROVIDER=whisper_local
# tiny | base | small | medium | large-v3 | turbo   (bigger = more accurate, slower)
NEXUS_WHISPER_MODEL=small
# Leave empty to auto-detect the spoken language, or set e.g. "en".
NEXUS_WHISPER_LANGUAGE=
NEXUS_WHISPER_DEVICE=auto
NEXUS_WHISPER_COMPUTE_TYPE=auto

# --- Background work --------------------------------------------------------
# "background": captures save instantly, AI work happens afterwards (default).
# "sync": AI work happens before the capture request returns.
NEXUS_PROCESSING_MODE=background

# --- External provider credentials (only used if you choose that provider) --
# Keys live ONLY in the environment. NEXUS never writes them to the database.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
