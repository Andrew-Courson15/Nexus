# NEXUS configuration. Copy to `.env` and adjust. Never commit your real `.env`.

# --- Server -----------------------------------------------------------------
# Keep NEXUS on the loopback interface. Do not expose it to the internet.
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000
# Host headers the server will answer to (protects against DNS rebinding).
NEXUS_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Storage ----------------------------------------------------------------
# Folder for uploaded audio/images/files and the default SQLite database.
NEXUS_DATA_DIR=./data
# Any SQLAlchemy URL. Defaults to sqlite:///<NEXUS_DATA_DIR>/nexus.db
# NEXUS_DATABASE_URL=sqlite:///./data/nexus.db
NEXUS_MAX_UPLOAD_MB=100

# --- AI provider ------------------------------------------------------------
# "local" = built-in offline heuristic organizer (default, sends nothing anywhere).
# Other names are reserved for future providers: openai, anthropic, local_model.
NEXUS_AI_PROVIDER=local
# Minimum confidence (0-1) for an AI relationship suggestion to be stored.
NEXUS_RELATIONSHIP_THRESHOLD=0.25

# --- Transcription ----------------------------------------------------------
# "placeholder" stores audio and leaves the transcript empty (UNKNOWN).
# Reserved for future providers: whisper_local, openai_whisper.
NEXUS_TRANSCRIPTION_PROVIDER=placeholder

# --- External provider credentials (only used if you choose that provider) --
# Keys live ONLY in the environment. NEXUS never writes them to the database.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
